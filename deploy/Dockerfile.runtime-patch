ARG BASE_IMAGE=pwm-push-server:production
FROM ${BASE_IMAGE}

COPY bff /app/bin/bff
COPY httpserver /app/bin/httpserver
COPY session /app/bin/session
COPY etc /app/etc
COPY entrypoint.sh /app/docker/entrypoint.sh

RUN chmod 0755 /app/bin/bff /app/bin/httpserver /app/bin/session /app/docker/entrypoint.sh
