FROM golang:1.21-bookworm AS build
WORKDIR /src/pwm-server

COPY go.mod go.sum ./
COPY --from=proto . /src/pwm-teamgram-proto
RUN go mod download
COPY . .
RUN make all

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /src/pwm-server/pwm/bin /app/bin
COPY --from=build /src/pwm-server/pwm/etc /app/etc
COPY --from=build /src/pwm-server/pwm/docker/entrypoint.sh /app/docker/entrypoint.sh
RUN mkdir -p /app/etc2 /app/logs \
    && chmod +x /app/docker/entrypoint.sh /app/bin/runall.sh /app/bin/*

EXPOSE 10443 5222 8801 11444
ENTRYPOINT ["/app/docker/entrypoint.sh"]
